# LLM Provider — mặc định là "gemini"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Multi-Model Fallback (Optional)
# Ví dụ: FALLBACK_MODELS="gemini:gemini-1.5-flash-8b,openai:gpt-4o-mini"
FALLBACK_MODELS=
OPENAI_API_KEY=

# GitHub (optional, khuyến khích để tránh rate limit 60 req/hr)
GITHUB_TOKEN=

# Telegram (optional — nếu thiếu, tool vẫn chạy và chỉ tạo markdown)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
