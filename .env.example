# LLM Provider — mặc định là "gemini"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Multi-Model Fallback (Optional)
# Ví dụ: FALLBACK_MODELS="gemini:gemini-1.5-flash-8b,openai:gpt-4o-mini"

# GitHub (optional, khuyến khích để tránh rate limit 60 req/hr)
# Sử dụng RADAR_GH_TOKEN thay vì GITHUB_TOKEN để tránh lỗi khi deploy lên Github Actions
RADAR_GH_TOKEN=

# URL trang Github Pages của bạn (vd: https://obiotech.github.io/personal-ai-radar)
# Nếu có, link này sẽ được đính kèm vào cuối tin nhắn Telegram
PUBLIC_PAGE_URL=

# Telegram (optional — nếu thiếu, tool vẫn chạy và chỉ tạo markdown)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
